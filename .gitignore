.build/

# New local audio drops stay out of Git. Existing committed MP3 files
# remain tracked until deliberately migrated; ignore rules do not untrack them.
App/public/assets/*.mp3
App/public/assets/music/**/*.mp3
wallpapers/
App/public/assets/wallpapers/macos/

# Local typing sound samples
App/public/assets/typing/**/*.wav
Resources/TypingPacks/**/*.wav

# --- Agent / proof scaffolding: local only, never in the public repo ---
.opencode/
.proof/
goal.yaml
GOAL.md
AGENTS.md
RULES.md
GIT-SKILLS.md

# --- Local verification artifacts (recordings, renders, screenshots) ---
validation/
repro-out/
LUMEN-DESIGN-FIX screenshots/
screenshot.png
Docs/**/*.png

# --- Generated RNNoise model weights ---
# 78 MB of pretrained LPCNet weights dumped as C float arrays. Generated from
# the upstream xiph model archive; fetch it with Tools/vendor-rnnoise.sh.
# Keeping it untracked stops GitHub Linguist from reporting this repo as C.
Sources/CRNNoise/src/rnnoise_data.c

# --- OS noise ---
.DS_Store

