{
  "name": "lumen-promo",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion promo for Lumen. Props in, MP4 out.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:16x9": "remotion render src/index.ts Promo-16x9 out/promo-16x9.mp4 --props=./props.json --codec=h264 --crf=12 --pixel-format=yuv420p --x264-preset=slow",
    "render:9x16": "remotion render src/index.ts Promo-9x16 out/promo-9x16.mp4 --props=./props.9x16.json --codec=h264 --crf=12 --pixel-format=yuv420p --x264-preset=slow"
  },
  "dependencies": {
    "@remotion/cli": "4.0.545",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.545"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
